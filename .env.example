# Copy to .env.local (gitignored) and fill in. Never commit real values.
# The scripts in scripts/ read this file; scripts/push-vercel-env.mjs copies it into Vercel.

# HubSpot app (Development > Projects > fernhill-order-sync > app)
HUBSPOT_TOKEN=""            # Distribution tab: access token (static auth)
HUBSPOT_CLIENT_SECRET=""    # Auth tab: client secret (verifies webhook and card signatures)
HUBSPOT_APP_ID=""           # Auth tab: app ID (used to recognise the app's own writes)
HUBSPOT_PORTAL_ID=""        # Your HubSpot account ID

# Supabase (Project Settings > API Keys, and Connect > Session pooler)
SUPABASE_SECRET_KEY=""      # sb_secret_... (server only)
SUPABASE_DB_URL=""          # postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL is derived from SUPABASE_DB_URL; set it only to override.

# Generated by scripts/push-vercel-env.mjs if missing
DRAIN_SECRET=""
CRON_SECRET=""
RATE_LIMIT_SALT=""
